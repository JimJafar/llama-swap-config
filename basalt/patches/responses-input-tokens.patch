Responses usage.input_tokens: report the engine-counted prompt, not len(text)//4.
Base: 84710728 (github.com/jesdga95/basalt). Apply in ~/lab/basalt: git apply ~/llama-swap/basalt/patches/responses-input-tokens.patch
Still needed upstream as of origin/main 6809edfa (2026-11-15).

diff --git a/serve/service.py b/serve/service.py
index 5db379cd..5c1f4cb3 100644
--- a/serve/service.py
+++ b/serve/service.py
@@ -1465,8 +1465,10 @@ class Service:
             yield "event", ev
         if stops is not None and stops.hit is None and stops.held:
             yield "event", Event("content", stops.flush())     # the held tail was not a stop string
+        # prompt_tokens: the engine's count now that it has read the prompt. A PromptText's length before then is
+        # len(text) // 4, which the Responses API otherwise reports as usage.input_tokens (16-19% low on code).
         done = {"finish": finish, "completion_tokens": n, "reused": (timings or {}).get("cache_n", 0),
-                "timings": timings, "reasoning_tokens": thinking_n}
+                "timings": timings, "reasoning_tokens": thinking_n, "prompt_tokens": len(ids)}
         if stops is not None and stops.hit is not None:
             done["stop_sequence"] = stops.hit
         yield "done", done
